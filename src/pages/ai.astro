---
// The AI product page. Name is a placeholder (AI_NAME in data/site.js).
// Copy only claims what's confirmed: it's bespoke, owned by the client,
// connects to their tools, takes actions, and builds sites and apps.
// Where it runs, what model it's built on, and results are NOT confirmed,
// so they're marked. Never name a competitor on this page.
import Base from '../layouts/Base.astro';
import Ph from '../components/Ph.astro';
import Confirm from '../components/Confirm.astro';
import Mood from '../components/Mood.astro';
import Accordion from '../components/Accordion.astro';
import { AI_NAME } from '../data/site.js';
import { LAYERS, mv } from '../data/layers.js';

const beats = [
  { id: 'sees', tag: 'Sees', title: 'One view of your whole business.', text: 'Your email, files, CRM, finance and operations tools, connected into one picture you can question in plain language. No dashboards to build first.', media: 'Visual: many tools flowing into one view' },
  { id: 'answers', tag: 'Answers', title: 'Answers from your numbers, not the internet’s.', text: 'Ask why margins moved last quarter, which customers are slipping, or what’s stuck in the pipeline, and get an answer built from your own data.', media: 'Visual: a question and its answer, from real screens' },
  { id: 'builds', tag: 'Builds', title: 'It doesn’t just answer. It does the work.', text: 'It drafts, files, flags and follows up. Ask for an internal tool, a site or an app, and it builds it. That’s what we mean by agentic: it acts, it doesn’t just advise.', media: 'Visual: the product building a tool, start to finish' },
];
const compare = [
  ['Who it’s built for', 'Everyone who signs up', 'Your company, and only yours'],
  ['Who owns it', 'The vendor. You rent access', 'You do'],
  ['What it knows', 'The public internet', 'Your business, across every tool you use'],
  ['What it does', 'Answers questions', 'Answers, then takes action and builds'],
  ['Where it lives', 'A chat window', 'Inside the systems you already run'],
];
const setup = [
  ['Map', 'We sit down with your team and map how the business actually runs: the tools, the data, and the work that eats the most time.'],
  ['Connect', 'We plug it into the systems you already use. If your business runs on it, it can connect to it.'],
  ['Build', 'We shape it around your business, your language and your rules, and build the first workflows with you.'],
  ['Run', 'Your team starts using it day to day. We stay on to extend it as the business asks more of it.'],
];
const faq = [
  ['Is it just ChatGPT with our logo on it?', 'No. It’s built for your company and owned by you. It works from your own data and tools, and it takes action instead of only answering. [Add one sentence on what it’s built on once confirmed.]'],
  ['Where does our data live?', '[To confirm with the client: on your own servers, a private cloud, or hosted by the team. Don’t publish an answer until this is confirmed.]'],
  ['What can it connect to?', 'If your business uses it, it can plug into it: email, files, CRM, accounting, e-commerce, messaging and custom systems. [List confirmed tools.]'],
  ['How long does setup take?', '[Typical timeline, once confirmed.]'],
  ['Who can see what it knows?', '[Access controls and permissions, once confirmed.]'],
];
---
<Base title={AI_NAME} description={`${AI_NAME}: your company's own AI. Built for you, owned by you. It knows your business, plugs into the tools you use, and does the work.`}>
  <!-- Hero. The code rain is gone (Oct 25). -->
  <section class="hero clip">
    <div class="hero__inner">
      <span class="pf-pill pf-pill--tag">{AI_NAME} · by Profectus</span>
      <h1 class="pf-display">Your Company's<br /><em>Own</em> AI.</h1>
      <p class="t-lead">It knows your business, plugs into every tool you use, and doesn’t just answer questions. It does the work. Built for you, owned by you.</p>
      <div class="pills pills--center">
        <a class="pf-pill" href="/contact" data-contact>Book a Demo →</a>
        <a class="pf-pill pf-pill--ghost" href="#how">See How It Works ↓</a>
      </div>
    </div>
  </section>

  <!-- Jump nav: pins under the header (Epsilon) -->
  <nav class="jump" aria-label="On this page">
    <div class="wrap"><ul class="pf-eyebrow">
      <li><a href="#what">What it does</a></li><li><a href="#compare">Owned, not rented</a></li>
      <li><a href="#connects">Connects</a></li><li><a href="#how">How setup works</a></li>
      <li><a href="#demo">Demo</a></li><li><a href="#faq">FAQ</a></li>
    </ul></div>
  </nav>

  <!-- The page's one scrubbed statement -->
  <section class="section" id="what">
    <div class="wrap statement">
      <p class="pf-eyebrow">What it does</p>
      <h2 class:list={['pf-h2', mv.scrub]}>Most AI answers questions. This one does the work.</h2>
    </div>
  </section>

  <!-- Sees / Answers / Builds: alternating rows (Epsilon) -->
  <section class="section section--flush-top">
    <div class="wrap alt">
      {beats.map((b, i) => (
        <div class="alt__row" id={b.id}>
          <div class="stack">
            <p class="pf-eyebrow">0{i + 1} · {b.tag}</p>
            <h3 class="t-h3s">{b.title}</h3>
            <p class="t-soft measure">{b.text}</p>
          </div>
          <div class="pf-glass alt__media" style="padding:0"><Ph label={b.media} style="position:absolute;inset:0;background-color:transparent" /></div>
        </div>
      ))}
    </div>
  </section>

  <Mood eyebrow={AI_NAME} title="See your <em>whole</em> business at once." variant="plum" />

  <!-- Owned, not rented: comparison without naming anyone (Epsilon "vs") -->
  <section class="section" id="compare">
    <div class="wrap ti">
      <div class="head">
        <p class="pf-eyebrow">Owned, not rented</p>
        <h2 class="pf-h2">Stop renting AI. <em>Own</em> it.</h2>
        <p class="t-soft">Most AI is a rental: shared, generic, and someone else’s. Yours should know your business and answer only to you.</p>
      </div>
      <div class="compare-wrap">
        <table class="compare">
          <thead><tr><th scope="col"><span class="sr-only">Question</span></th><th scope="col">Off-the-shelf AI</th><th scope="col">{AI_NAME}</th></tr></thead>
          <tbody>{compare.map(([q, a, b]) => <tr><th scope="row">{q}</th><td>{a}</td><td>{b}</td></tr>)}</tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Tool wall: static, confirmed logos only -->
  <section class="section section--flush-top" id="connects">
    <div class="wrap">
      <div class="head">
        <p class="pf-eyebrow">Connects</p>
        <h2 class="pf-h2">If your business uses it, it can plug into it.</h2>
        <p class="t-soft">Logos go here once each integration is confirmed. <Confirm /></p>
      </div>
      <div class="logo-wall">{Array.from({ length: 12 }, (_, i) => <Ph label={`Tool logo ${i + 1}`} />)}</div>
    </div>
  </section>

  <!-- Setup in four steps -->
  <section class="section" id="how">
    <div class="wrap">
      <div class="head">
        <p class="pf-eyebrow">How setup works</p>
        <h2 class="pf-h2">We come in, map your business, and build it <em>with</em> you.</h2>
      </div>
      <ol class="steps" style="--n:4">
        {setup.map(([t, d], i) => <li><span class="pf-eyebrow">0{i + 1}</span><h3 class="t-h3">{t}</h3><p class="t-soft">{d}</p></li>)}
      </ol>
    </div>
  </section>

  <!-- Demo video: click to load, never autoplays -->
  <section class="section section--flush-top" id="demo">
    <div class="wrap">
      <div class="head">
        <p class="pf-eyebrow">Demo</p>
        <h2 class="pf-h2">Watch it answer, then build.</h2>
      </div>
      <Ph class="cs-hero-media" label="60 to 90 second demo video, loads on click" />
    </div>
  </section>

  <!-- Founding-client offer: the proof we don't have yet -->
  <Mood eyebrow="Founding clients" title="Be one of the <em>first</em>." pill="Apply to Be a Founding Client" contact={true}>
    <p class="t-soft measure">A limited number of founding clients get early pricing and hands-on setup, in exchange for helping us tell the story. <Confirm /></p>
  </Mood>

  <section class="section" id="faq">
    <div class="wrap ti">
      <div class="head">
        <p class="pf-eyebrow">FAQ</p>
        <h2 class="pf-h2">Questions Buyers Ask</h2>
      </div>
      <Accordion items={faq} />
    </div>
  </section>
</Base>
