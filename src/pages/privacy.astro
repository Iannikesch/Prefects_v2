---
// The live privacy page is another company's policy ("Anker"), so it can't
// be carried over. The client needs to supply a real one.
import Base from '../layouts/Base.astro';
---
<Base title="Privacy Policy" footerCta={false}>
  <section class="hero hero--page hero--left">
    <div class="wrap hero__inner">
      <p class="pf-eyebrow">Legal</p>
      <h1 class="t-h1">Privacy Policy</h1>
    </div>
  </section>
  <section class="section section--flush-top">
    <div class="wrap stack measure">
      <p class="ph" style="place-items:start;text-align:left"><span>Placeholder · The client must supply a privacy policy for The Profectus Agency. The live site's policy belongs to another company and can't be reused.</span></p>
    </div>
  </section>
</Base>
