---
// Case study listing: heading, count, cards. No filters until there are ~12.
import Base from '../../layouts/Base.astro';
import CaseCard from '../../components/CaseCard.astro';
import { CASE_STUDIES } from '../../data/caseStudies.js';
import Aurora from '../../components/Aurora.astro';
import { SHOW_CASE_STUDIES } from '../../data/site.js';
// Hidden while the case studies are still placeholders: send anyone with the URL home.
if (!SHOW_CASE_STUDIES) return Astro.redirect('/');
---
<Base title="Case Studies" description="Progress stories with real numbers from real clients: brand launches, expansions and go-to-market programs built on Profectus's own data.">
  <section class="hero hero--page hero--left">
    <Aurora />
    <div class="wrap hero__inner">
      <p class="pf-eyebrow">Case studies</p>
      <h1 class="t-h1">Progress Stories. Real Numbers. <em>Real</em> Clients.</h1>
      <p class="t-lead measure">Every engagement starts with something that isn't working, usually in the data layer underneath everything else. Every one ends with a foundation built to keep compounding. Here's what that looks like.</p>
    </div>
  </section>
  <section class="section section--flush-top">
    <div class="wrap">
      <p class="pf-eyebrow" style="margin-bottom:24px">{CASE_STUDIES.length} case studies</p>
      <ul class="cards">{CASE_STUDIES.map((cs, i) => <li><CaseCard cs={cs} isNew={i === 0} /></li>)}</ul>
    </div>
  </section>
</Base>
