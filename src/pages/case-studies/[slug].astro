---
// Case study template (Merkle + Deloitte + Epsilon), using Profectus's own
// three-part story: What We Inherited, What We Built, What Changed.
import Base from '../../layouts/Base.astro';
import Ph from '../../components/Ph.astro';
import Confirm from '../../components/Confirm.astro';
import Mood from '../../components/Mood.astro';
import CaseRail from '../../components/CaseRail.astro';
import { CASE_STUDIES, caseBySlug, formatDate } from '../../data/caseStudies.js';
import { bySlug } from '../../data/capabilities.js';
import { LAYERS, mv } from '../../data/layers.js';

export function getStaticPaths() {
  return CASE_STUDIES.map((c) => ({ params: { slug: c.slug } }));
}
const cs = caseBySlug(Astro.params.slug);
const i = CASE_STUDIES.indexOf(cs);
const next = CASE_STUDIES[(i + 1) % CASE_STUDIES.length];
const others = CASE_STUDIES.filter((c) => c.slug !== cs.slug);
---
<Base title={`${cs.client}: ${cs.title}`} description={cs.summary}>
  <!-- Title band -->
  <section class="hero hero--page hero--left" style="padding-bottom:56px">
    <div class="wrap hero__inner">
      <ol class="crumbs pf-eyebrow"><li><a href="/case-studies">Case studies</a></li><li>{cs.client}</li></ol>
      <h1 class="t-h1">{cs.title}</h1>
      <div class="cs-meta">
        <span class="pf-eyebrow">{cs.client}</span>
        <span class="pf-eyebrow">{formatDate(cs.date)}</span>
      </div>
      <ul class="chips">{cs.services.map((s) => <li><a class="pf-chip" href={`/capabilities/${s}`}>{bySlug(s).name}</a></li>)}</ul>
    </div>
  </section>

  <div class="wrap"><Ph class="cs-hero-media" label={`${cs.client} hero photo`} /></div>

  <!-- Overview + 2×2 stats (Merkle) -->
  <section class="section">
    <div class="wrap cs-overview">
      <div class="head">
        <p class="pf-eyebrow">Overview</p>
        <p class="t-lead">{cs.summary}</p>
      </div>
      <div class="stat-row stat-row--2x2">
        {cs.stats.map((s) => <div><span class="pf-stat">{s.value}</span><span class="pf-eyebrow">{s.label}</span>{s.confirm && <Confirm />}</div>)}
      </div>
    </div>
  </section>

  <!-- The story -->
  <section class="section section--flush-top">
    <div class="wrap prose-rows">
      <div><p class="pf-eyebrow">01 · What we inherited</p><p class="t-lead t-soft">{cs.inherited}</p></div>
      <div><p class="pf-eyebrow">02 · What we built</p><p class="t-lead t-soft">{cs.built}</p></div>
    </div>
  </section>

  <!-- Full-screen pacing photo, no text (Merkle), with Profectus parallax -->
  <section class:list={[mv.parallax, 'band-photo band-photo--full']} aria-label="Photo">
    <Ph class="pm-parallax__plate" label={`${cs.client} full-screen photo`} />
  </section>

  <section class="section">
    <div class="wrap prose-rows">
      <div><p class="pf-eyebrow">03 · What changed</p><p class="t-lead">{cs.changed}</p></div>
    </div>
  </section>

  <!-- Client quote in a mood band (Deloitte) -->
  <Mood eyebrow={`${cs.client} · [Name, Title]`} title="“[Client quote. One or two sentences on what changed for them.]”">
    <Confirm />
  </Mood>

  <!-- Next pick for you (Epsilon) -->
  <section class="section">
    <div class="wrap">
      <p class="pf-eyebrow" style="margin-bottom:24px">Next pick for you</p>
      <a class="next-pick" href={`/case-studies/${next.slug}`}>
        <Ph label={`${next.client} photo`} />
        <div class="next-pick__body">
          <p class="pf-eyebrow">{next.client}</p>
          <h2 class="t-h3s">{next.title}</h2>
          <p class="t-body">{next.summary}</p>
          <span class="link-arrow">Read the case study →</span>
        </div>
      </a>
    </div>
  </section>

  <section class="section section--flush-top">
    <div class="wrap"><CaseRail eyebrow="More work" title="Real Challenges. Real Outcomes." cases={others} /></div>
  </section>
</Base>
