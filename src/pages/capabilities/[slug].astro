---
// One page per capability, reimagined (Oct 22). Content per slug lives in
// src/reimagined/<slug>.html (ported from the prototypes); the previous
// template is _prev-slug.astro.
import Fresh from '../../layouts/Fresh.astro';
import '../../reimagined/reimagined.css';
import '../../reimagined/tight.css';
import { CAPABILITIES, bySlug } from '../../data/capabilities.js';

const pages = import.meta.glob('../../reimagined/*.html', { query: '?raw', import: 'default', eager: true });
export function getStaticPaths() {
  return CAPABILITIES.map((c) => ({ params: { slug: c.slug } }));
}
const cap = bySlug(Astro.params.slug);
const body = pages[`../../reimagined/${cap.slug}.html`];
---
<Fresh title={`${cap.name} · Profectus Agency`}>
  <div class="rm"><script is:inline>document.currentScript.parentElement.classList.add('js');</script><Fragment set:html={body} /></div>
</Fresh>
