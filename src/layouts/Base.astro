---
// Every page is wrapped in this: head, header, footer, contact pop-up, and
// the kit (texture pack + motion system) loaded once. The header is the
// shared FreshNav (Oct 25) and the footer is the shared FreshFooter (Oct 26),
// the same as the rest of the site.
import '../../kit/texture-pack/profectus-texture.css';
import '../../kit/motion-system/motion-system.css';
import '../styles/site.css';
import ContactForm from '../components/ContactForm.astro';
import { SITE, AI_NAME, AI_PATH } from '../data/site.js';
import FreshFooter from '../components/FreshFooter.astro';
import FreshNav from '../components/FreshNav.astro';
import { LAYERS } from '../data/layers.js';

const { title, description = SITE.description } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const fullTitle = title ? `${title} | ${SITE.name}` : SITE.name;
const canonical = new URL(path, SITE.url).href;
---
<!doctype html>
<html lang="en" data-smooth={LAYERS.smooth ? "on" : undefined} data-nav-hide={LAYERS.navHide ? "on" : undefined}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#000000" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://api.fontshare.com" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=erode@400,500&display=swap" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500&family=Instrument+Serif:ital@1&family=PT+Mono&display=swap" />
  <!-- Failstop: if scripts never run, nothing that starts hidden stays hidden. -->
  <noscript><style>.pm-rise { opacity: 1 !important; translate: none !important; }</style></noscript>
</head>
<body data-pm-cursor={LAYERS.cursor ? "" : undefined}>
  <a class="skip pf-pill" href="#main">Skip to content</a>

  <FreshNav />

  <main id="main"><slot /></main>

  <FreshFooter />

  <dialog class="modal" id="contact-modal" aria-labelledby="contact-modal-title">
    <div class="modal__panel">
      <button class="modal__close" type="button" aria-label="Close">×</button>
      <p class="pf-eyebrow">Your next customer is probably in our database. Let's go find them.</p>
      <h2 class="t-h3s" id="contact-modal-title" style="margin:12px 0 28px">Let's Talk About What's Not Working.</h2>
      <ContactForm />
    </div>
  </dialog>

  <script>
    import '../scripts/lenis-global.js';
    import '../../kit/motion-system/motion-system.js';
    import '../../kit/texture-pack/nebula.js';
    import '../scripts/site.js';
  </script>
</body>
</html>
