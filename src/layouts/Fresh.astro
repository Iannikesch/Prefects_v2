---
// The rework starts here: a fresh layout. Inbound-style nav (frosted,
// black over the hero, white once you scroll), white page, and the kit's
// colours, fonts and movers. The old Base.astro is untouched for reference.
import '../../kit/texture-pack/profectus-texture.css';
import '../../kit/motion-system/motion-system.css';
import '../styles/fresh.css';
const { title = 'Profectus Agency' } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=erode@400,500&display=swap" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500&family=Instrument+Serif:ital@1&family=PT+Mono&display=swap" />
</head>
<body>
  <header class="fnav" data-fnav>
    <div class="fnav__bar">
      <a class="fnav__logo" href="/">Profectus</a>
      <nav aria-label="Main">
        <ul class="fnav__links">
          <li><a href="/capabilities">Capabilities</a></li>
          <li><a href="/case-studies">Case Studies</a></li>
          <li><a href="/about">About</a></li>
        </ul>
      </nav>
      <a class="fnav__cta btn-gold glow" href="/contact">Get in Touch →</a>
    </div>
  </header>

  <main><slot /></main>

  <script>
    import '../../kit/texture-pack/code-rain.js';
    import '../../kit/texture-pack/nebula.js';
    import '../scripts/cascade.js';
    import '../scripts/coverflow.js';
    // Nav, measured on deloittedigital.com:
    // - Hide on any downward scroll once past the very top (y > 2); reveal on
    //   any upward scroll. No threshold, no delay. 200ms slide (CSS).
    // - Clear while the bar sits over the hero; white once it's past the
    //   hero's bottom edge (y >= heroHeight - navHeight), whichever way you go.
    // Gold glow: fades out across the first 175px of scroll (--glow).
    // One write per frame at most, only to the nav and the hero.
    const nav = document.querySelector('[data-fnav]');
    const hero = document.querySelector('[data-hero]');
    const turn = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--rw-nav-turn')) || 175;
    let queued = false, lastG = -1, lastY = scrollY, hidden = false, light = null;
    const apply = () => {
      queued = false;
      const y = scrollY, dy = y - lastY;
      lastY = y;
      if (dy > 0 && y > 2 && !hidden) { hidden = true; nav.classList.add('is-hidden'); }
      else if (dy < 0 && hidden) { hidden = false; nav.classList.remove('is-hidden'); }
      const edge = hero ? hero.offsetHeight - nav.offsetHeight : 0;
      const isLight = y >= edge;
      if (isLight !== light) { light = isLight; nav.classList.toggle('is-light', isLight); }
      const g = 1 - Math.min(1, Math.max(0, y / turn));
      if (Math.abs(g - lastG) >= 0.004) {
        lastG = g;
        nav.style.setProperty('--glow', g.toFixed(3));
        if (hero) hero.style.setProperty('--glow', g.toFixed(3));
      }
    };
    addEventListener('scroll', () => { if (!queued) { queued = true; requestAnimationFrame(apply); } }, { passive: true });
    // Keyboard users: focus inside a hidden nav brings it back.
    nav.addEventListener('focusin', () => { hidden = false; nav.classList.remove('is-hidden'); });
    apply();

    // Trusted logos: reveal once when the row is in view, then hand the
    // transitions over to hover.
    const trusted = document.querySelector('[data-trusted]');
    if (trusted) {
      new IntersectionObserver(([e], o) => {
        if (!e.isIntersecting) return;
        o.disconnect();
        trusted.classList.add('is-in');
        setTimeout(() => trusted.classList.add('is-done'), 400 + 83 * 7 + 700);
      }, { threshold: 0.4 }).observe(trusted);
    }
  </script>
</body>
</html>
