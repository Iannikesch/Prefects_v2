---
// The rework starts here: a fresh layout. Inbound-style nav (frosted,
// black over the hero, white once you scroll), white page, and the kit's
// colours, fonts and movers. The old Base.astro is untouched for reference.
import '../../kit/texture-pack/profectus-texture.css';
import '../../kit/motion-system/motion-system.css';
import '../styles/fresh.css';
const { title = 'Profectus Agency' } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=erode@400,500&display=swap" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500&family=Instrument+Serif:ital@1&family=PT+Mono&display=swap" />
</head>
<body>
  <header class="fnav" data-fnav>
    <div class="fnav__bar">
      <a class="fnav__logo" href="/">Profectus</a>
      <nav aria-label="Main">
        <ul class="fnav__links">
          <li><a href="/capabilities">Capabilities</a></li>
          <li><a href="/ai">[AI Product]</a></li>
          <li><a href="/case-studies">Case Studies</a></li>
          <li><a href="/about">About</a></li>
        </ul>
      </nav>
      <a class="fnav__cta btn-gold glow" href="/contact">Get in Touch →</a>
    </div>
  </header>

  <main><slot /></main>

  <script>
    import '../../kit/texture-pack/code-rain.js';
    import '../../kit/texture-pack/nebula.js';
    import '../scripts/cascade.js';
    // Nav: Inbound's colour fade plus Deloitte's hide and reveal.
    // - Colour: clear over the hero, fading to frosted white across the first
    //   175px of scroll (--p), and the gold glow fading out with it (--glow).
    // - Position: scrolling down past the nav's own height slides it out of
    //   view; scrolling up brings it back, already white.
    // One write per frame at most (rAF), only to the nav and the hero.
    const nav = document.querySelector('[data-fnav]');
    const hero = document.querySelector('[data-hero]');
    const rootCS = getComputedStyle(document.documentElement);
    const turn = parseFloat(rootCS.getPropertyValue('--rw-nav-turn')) || 175;
    const HIDE_AFTER = nav.offsetHeight;     // never hide while it still overlaps the very top
    const NUDGE = 6;                         // ignore tiny wobbles in scroll position
    let queued = false, lastP = -1, lastY = scrollY, hidden = false;
    const apply = () => {
      queued = false;
      const y = scrollY, dy = y - lastY;
      const p = Math.min(1, Math.max(0, y / turn));
      if (Math.abs(p - lastP) >= 0.004) {
        lastP = p;
        nav.style.setProperty('--p', p.toFixed(3));
        nav.classList.toggle('is-scrolled', p > 0);
        const g = (1 - p).toFixed(3);
        nav.style.setProperty('--glow', g);
        if (hero) hero.style.setProperty('--glow', g);
      }
      if (Math.abs(dy) >= NUDGE) {
        const hide = dy > 0 && y > HIDE_AFTER;
        if (hide !== hidden) { hidden = hide; nav.classList.toggle('is-hidden', hide); }
        lastY = y;
      }
    };
    addEventListener('scroll', () => { if (!queued) { queued = true; requestAnimationFrame(apply); } }, { passive: true });
    // Keyboard users: a focused link inside a hidden nav brings it back.
    nav.addEventListener('focusin', () => { hidden = false; nav.classList.remove('is-hidden'); });
    apply();
  </script>
</body>
</html>
