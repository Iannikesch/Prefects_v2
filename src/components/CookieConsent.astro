---
// Cookie banner and settings panel (Oct 27), modelled on epsilon.com's
// (kit/scouted/epsilon-com-cookie-banner.md) in our colours. Behaves like
// theirs, by the owner's call (Oct 27): their copy word for word (Braxton's three typo fixes Oct 29), "Close" and
// the X accept all, optional cookies on by default (opt-out), and the banner
// shows about 3s after load. The choice is a first-party cookie, pf_consent.
// Scripts that need consent check window.pfConsent or listen for
// 'pf:consent'. Styles in src/styles/consent.css.
import '../styles/consent.css';
const GROUPS = [
  { key: 'necessary', name: 'Strictly Necessary', always: true,
    text: ['These cookies are necessary for the website to function and cannot be switched off in our systems. Some of these cookies are only set in response to requests made by you, such as setting your preferences, logging in or filling out forms. They may also be set for certain security purposes and network management. You can manage these types of cookies using your browser settings, but it may affect your ability to use our website.'] },
  { key: 'functional', name: 'Functional',
    text: ['These cookies enable the website to provide enhanced functionality and improve your experience. They may be set by us or by third-party providers whose services have been added to our website. If you do not allow these cookies, you may not receive the best experience when visiting our website and parts of our website may not function properly.'] },
  { key: 'performance', name: 'Performance',
    text: ['These cookies allow us to engage in certain activities, such as counting visits and identifying traffic sources that assist us in measuring the performance of our website. They help us to know which pages are the most and least popular and see how visitors move around the website. If you do not allow these cookies we will not know when you have visited our website and will not be able to monitor our website’s performance.'] },
  { key: 'targeting', name: 'Targeting',
    text: [
      'These cookies are used to collect information about your browser, device and website visit and use such information to provide you with personalized experiences and advertising on this website and others across the internet. If these cookies are disabled, your data will not be shared with third parties for this purpose.',
      'If you are located in the United States, local law may provide you with the right to opt-out of the sale or sharing of your personal information to third parties. You may exercise your right to opt out of this activity by disabling targeting cookies using this toggle switch. Additionally, you may find further information about exercising your consumer rights under local law by visiting our Privacy Policy.',
    ] },
];
---
<div class="pfc" data-pfc hidden role="region" aria-label="Cookie notice">
  <div class="pfc__inner">
    <div class="pfc__copy">
      <p class="pfc__k">Cookies</p>
      <p class="pfc__text">We use cookies to remember your preferences and visits. See our Privacy Policy (section X) for details. Select “Close” or ‘x’ to allow all cookies. Choose “Customize” to manage which cookies are used. “Decline” blocks all except strictly necessary cookies. <a href="/privacy" target="_blank" rel="noopener noreferrer" aria-label="Legal Information, opens in a new tab">Privacy Policy.</a></p>
    </div>
    <div class="pfc__btns">
      <button class="pfc__btn pfc__btn--line" type="button" data-pfc-open aria-haspopup="dialog">Customize</button>
      <button class="pfc__btn" type="button" data-pfc-decline>Decline</button>
      <button class="pfc__btn" type="button" data-pfc-accept>Close</button>
    </div>
    <button class="pfc__x" type="button" data-pfc-accept aria-label="Close">×</button>
  </div>
</div>
<script is:inline>
  // Show the banner about 3s after load, only if no choice is saved yet.
  if (!/(?:^|; )pf_consent=/.test(document.cookie)) setTimeout(() => { document.querySelector('[data-pfc]').hidden = false; }, 3000);
</script>

<dialog class="pfc-panel" data-pfc-panel aria-labelledby="pfc-title">
  <form method="dialog" class="pfc-panel__form">
    <header class="pfc-panel__head">
      <span class="pfc-panel__logo"><img src="/img/brand/profectus-black.png" srcset="/img/brand/profectus-black.png 1x, /img/brand/profectus-black@2x.png 2x" width="549" height="96" alt="Profectus" /></span>
      <button class="pfc-panel__x" type="submit" value="close" aria-label="Close">×</button>
    </header>
    <div class="pfc-panel__body">
      <h2 id="pfc-title">Cookie Preference Settings</h2>
      <p>When you visit our website, we store cookies on your browser to collect information. The information collected might relate to you, your preferences or your device, and is mostly used to make the site work as you expect it to and to provide a more personalized web experience. However, you can choose not to allow certain types of cookies, which may impact your experience of the site and the services we are able to offer.</p>
      <p><a href="/privacy">The Profectus Agency Privacy Policy</a></p>
      <h3>Manage Consent Preferences</h3>
      <div class="pfc-panel__groups">
        {GROUPS.map((g) => (
          <details class="pfc-group">
            <summary>
              <span class="pfc-group__name">{g.name}</span>
              {g.always
                ? <span class="pfc-group__always">Always Active</span>
                : <label class="pfc-switch" onclick="event.stopPropagation()"><input type="checkbox" name={g.key} data-pfc-group={g.key} checked /><i aria-hidden="true"></i><span class="pfc-sr">{g.name} cookies</span></label>}
            </summary>
            {g.text.map((t) => <p>{t}</p>)}
          </details>
        ))}
      </div>
    </div>
    <footer class="pfc-panel__foot">
      <button class="pfc__btn pfc__btn--line" type="button" data-pfc-decline>Decline All</button>
      <button class="pfc__btn" type="button" data-pfc-save>Confirm My Choices</button>
    </footer>
  </form>
</dialog>

<script>
  const NAME = 'pf_consent';
  const OPTIONAL = ['functional', 'performance', 'targeting'];
  const banner = document.querySelector('[data-pfc]');
  const panel = document.querySelector('[data-pfc-panel]');
  const boxes = [...panel.querySelectorAll('[data-pfc-group]')];
  const read = () => {
    const m = document.cookie.match(/(?:^|; )pf_consent=([^;]*)/);
    try { return m ? JSON.parse(decodeURIComponent(m[1])) : null; } catch { return null; }
  };
  const save = (choice) => {
    const c = { necessary: true, ...choice, at: new Date().toISOString() };
    document.cookie = `${NAME}=${encodeURIComponent(JSON.stringify(c))}; Max-Age=${60 * 60 * 24 * 365}; Path=/; SameSite=Lax${location.protocol === 'https:' ? '; Secure' : ''}`;
    window.pfConsent = c;
    dispatchEvent(new CustomEvent('pf:consent', { detail: c }));
    banner.hidden = true;
    if (panel.open) panel.close();
  };
  const all = (on) => Object.fromEntries(OPTIONAL.map((k) => [k, on]));
  // Opt-out: until someone chooses, every category counts as allowed.
  window.pfConsent = read() || { necessary: true, ...all(true) };

  document.querySelectorAll('[data-pfc-accept]').forEach((b) => b.addEventListener('click', () => save(all(true))));
  document.querySelectorAll('[data-pfc-decline]').forEach((b) => b.addEventListener('click', () => save(all(false))));
  panel.querySelector('[data-pfc-save]').addEventListener('click', () => save(Object.fromEntries(boxes.map((b) => [b.name, b.checked]))));
  // Customize, and the footer's Cookie Settings link, open the panel with the saved choice.
  document.querySelectorAll('[data-pfc-open]').forEach((b) => b.addEventListener('click', (e) => {
    e.preventDefault();
    const c = read();
    boxes.forEach((b) => { b.checked = c ? !!c[b.name] : true; });
    panel.showModal();
  }));
  panel.addEventListener('click', (e) => { if (e.target === panel) panel.close(); });
</script>
