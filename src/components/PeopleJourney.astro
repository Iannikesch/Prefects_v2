---
// Homepage centrepiece (Oct 22): our take on the scroll journey on Epsilon's
// AI page (kit/scouted/epsilon-com-ai-capabilities-scroll-journey.md). The
// stage pins on the right while five panels scroll on the left; crossing a
// panel plays a timed scene change (not scrubbed). The same people and cards
// move between scenes, so the story reads as one customer coming together.
// Generated by scratchpad/journey.py; photos are illustrative, Maria is an example.
const PANELS = [
  ['Too many pieces. No picture.', "An email here, a device there, a purchase in the store. Most brands have the data. Few can tell you who it belongs to, or what she wants next."],
  ['So every message is a guess.', "Wrong message, wrong channel, wrong time, too often. Budget goes to people who were never going to buy, and misses the ones who were."],
  ['We put the pieces together.', "Every email, device and purchase matched to one real person. Then we learn what she cares about, and how and when she likes to hear from you."],
  ['Then every move is planned for her.', "Our operators decide what she hears, where, when, how often, and what it's worth spending. Across paid, owned and earned, in real time."],
  ['And you see what it earned.', "Every touch measured against what it caused. Not opens and clicks: purchases, return visits and lifetime value."],
];
---
<div class="pj" data-pj>
  <div class="pj__sticky">
    <div class="pj__panels">
      {PANELS.map(([h, t], i) => (
        <div class={`pj__panel${i === 0 ? ' is-on' : ''}`} data-pj-panel={i + 1}>
          <span class="pj__n">0{i + 1} / 05</span>
          <h3>{h}</h3>
          <p>{t}</p>
        </div>
      ))}
      <div class="pj__dots" aria-hidden="true">{PANELS.map((_, i) => <i class={i === 0 ? 'is-on' : ''} />)}</div>
    </div>
    <div class="pj__art">
      <div class="pj__stage" data-scene="1" data-pj-stage>
        <svg class="pj__tree pj__tree--2" viewBox="0 0 1000 620" aria-hidden="true"><path d="M600 110 V80 H660" class="pj__g"/><path d="M560 176 V200 H620" class="pj__g"/><path d="M560 272 V300 H610" class="pj__g"/><path d="M600 372 V345 H650" class="pj__g"/><path d="M580 432 V460 H630" class="pj__g"/><path d="M580 540 V565 H640" class="pj__g"/><path d="M315 180 H400 V140 H480 H600 V110 H700" style="stroke:#E79A9A"/><path d="M400 180 V232 H470 H560 V272 H640" style="stroke:#E79A9A"/><path d="M480 140 H560 V176 H660" style="stroke:#E79A9A"/><path d="M270 450 H400 V405 H490 H600 V372 H700" style="stroke:#E79A9A"/><path d="M490 405 H580 V432 H680" style="stroke:#E79A9A"/><path d="M400 450 V492 H480 H580 V540 H660" style="stroke:#E79A9A"/><circle cx="700" cy="110" r="7" style="fill:#C0392B"/><circle cx="660" cy="176" r="7" style="fill:#C0392B"/><circle cx="640" cy="272" r="7" style="fill:#C0392B"/><circle cx="700" cy="372" r="7" style="fill:#C0392B"/><circle cx="680" cy="432" r="7" style="fill:#C0392B"/><circle cx="660" cy="540" r="7" style="fill:#C0392B"/></svg>
        <svg class="pj__tree pj__tree--4" viewBox="0 0 1000 620" aria-hidden="true"><path d="M520 150 V120 H580" class="pj__g"/><path d="M640 140 V115 H700" class="pj__g"/><path d="M540 300 V275 H600" class="pj__g"/><path d="M660 305 V330 H720" class="pj__g"/><path d="M520 440 V410 H570" class="pj__g"/><path d="M640 460 V490 H700" class="pj__g"/><path d="M520 150 V178 H570" class="pj__g"/><path d="M335 210 H420 V150 H520 V140 H640 H800" style="stroke:#3E7BEA"/><path d="M420 210 V300 H540 V305 H660 H800" style="stroke:#2B2A6B"/><path d="M420 210 V380 H520 V440 H640 V460 H800" style="stroke:#9B7FD8"/><circle cx="800" cy="140" r="7" style="fill:#3E7BEA"/><circle cx="800" cy="305" r="7" style="fill:#2B2A6B"/><circle cx="800" cy="460" r="7" style="fill:#9B7FD8"/><circle cx="420" cy="210" r="7" style="fill:#3E7BEA"/></svg>
      <div class="pj__p pj__face" data-p="maria" aria-hidden="true"><img src="/img/photos/mail.webp" alt="" style="object-position:45% 28%" loading="lazy" decoding="async"></div>
      <div class="pj__p pj__face" data-p="p2" aria-hidden="true"><img src="/img/photos/coffee.webp" alt="" style="object-position:62% 40%" loading="lazy" decoding="async"></div>
      <div class="pj__p pj__face" data-p="p3" aria-hidden="true"><img src="/img/photos/notify.webp" alt="" style="object-position:55% 28%" loading="lazy" decoding="async"></div>
      <div class="pj__p pj__face" data-p="p4" aria-hidden="true"><img src="/img/photos/counter.webp" alt="" style="object-position:45% 22%" loading="lazy" decoding="async"></div>
      <div class="pj__p pj__face" data-p="p5" aria-hidden="true"><img src="/img/photos/owner-glasses.webp" alt="" style="object-position:48% 30%" loading="lazy" decoding="async"></div>
      <div class="pj__p pj__face" data-p="p6" aria-hidden="true"><img src="/img/photos/owner-typing.webp" alt="" style="object-position:50% 30%" loading="lazy" decoding="async"></div>
      <div class="pj__p pj__card" data-p="c1" aria-hidden="true"><i>@</i>maria.alvarez@…mail.com</div>
      <div class="pj__p pj__card" data-p="c2" aria-hidden="true"><i>▢</i>Device #4471 · iPhone</div>
      <div class="pj__p pj__card" data-p="c3" aria-hidden="true"><i>★</i>Loyalty #48213</div>
      <div class="pj__p pj__card" data-p="c4" aria-hidden="true"><i>↗</i>Read pricing page · 11:02pm</div>
      <div class="pj__p pj__card" data-p="c5" aria-hidden="true"><i>$</i>Purchased: Boots · $120</div>
      <div class="pj__p pj__card" data-p="c6" aria-hidden="true"><i>✉</i>Opened email · 7:40am</div>
      <div class="pj__p pj__card" data-p="c7" aria-hidden="true"><i>⌂</i>1182 Elm Street</div>
      <div class="pj__p pj__card" data-p="c8" aria-hidden="true"><i>▢</i>Chromebook</div>
      <div class="pj__p pj__grey" data-p="g0" aria-hidden="true"><span></span><span></span></div>
      <div class="pj__p pj__grey" data-p="g1" aria-hidden="true"><span></span><span></span></div>
      <div class="pj__p pj__grey" data-p="g2" aria-hidden="true"><span></span><span></span></div>
      <div class="pj__p pj__grey" data-p="g3" aria-hidden="true"><span></span><span></span></div>
      <div class="pj__p pj__grey" data-p="g4" aria-hidden="true"><span></span><span></span></div>
      <div class="pj__p pj__grey" data-p="g5" aria-hidden="true"><span></span><span></span></div>
      <div class="pj__p pj__grey" data-p="g6" aria-hidden="true"><span></span><span></span></div>
      <div class="pj__p pj__q" data-p="q1" aria-hidden="true"><i>?</i>Wrong message</div>
      <div class="pj__p pj__q" data-p="q2" aria-hidden="true"><i>?</i>Wrong channel</div>
      <div class="pj__p pj__q" data-p="q3" aria-hidden="true"><i>?</i>Spent too much</div>
      <div class="pj__p pj__q" data-p="q4" aria-hidden="true"><i>?</i>Wrong time</div>
      <div class="pj__p pj__q" data-p="q5" aria-hidden="true"><i>?</i>Too often</div>
      <div class="pj__p pj__profile" data-p="profile" aria-hidden="true"><div class="pj__row"><span>Maria Alvarez</span></div><div class="pj__row"><span>Austin, TX · since 2021</span></div><div class="pj__row pj__buy"><span class="pj__v3">Purchased: Boots</span><span class="pj__v5">Purchased: Jacket</span><b class="pj__v3">$120</b><b class="pj__v5">$180</b></div><div class="pj__row"><span>14 purchases · Loyalty member</span></div></div>
      <div class="pj__p pj__insight" data-p="insight" aria-hidden="true"><p class="pj__ih">Profectus insights</p><div class="pj__ir" style="--r:0"><i>P</i>Shops on iPhone after 8 pm</div><div class="pj__ir" style="--r:1"><i>P</i>Opens email, ignores texts</div><div class="pj__ir" style="--r:2"><i>P</i>Likely to buy again in 30 days</div><div class="pj__ir pj__v5only" style="--r:3"><i>P</i>Prefers a reminder, not a discount</div></div>
      <div class="pj__p pj__decide" data-p="d1" aria-hidden="true"><i>P</i>Email at 8:10 pm</div>
      <div class="pj__p pj__decide" data-p="d2" aria-hidden="true"><i>P</i>Show the boots she viewed</div>
      <div class="pj__p pj__decide" data-p="d3" aria-hidden="true"><i>P</i>Spend up to $6</div>
      <div class="pj__p pj__tag pj__tag--blue" data-p="t1" aria-hidden="true"><i>✓</i>Purchase</div>
      <div class="pj__p pj__tag pj__tag--navy" data-p="t2" aria-hidden="true"><i>✓</i>Review left</div>
      <div class="pj__p pj__tag pj__tag--lilac" data-p="t3" aria-hidden="true"><i>✓</i>Tier up</div>
      <div class="pj__p pj__email" data-p="email" aria-hidden="true"><p class="pj__em-from">Your store · 8:10 pm</p><p class="pj__em-sub">Still thinking about the boots, Maria?</p><span class="pj__em-img"></span><span class="pj__em-btn">Take another look</span><span class="pj__hand">☝</span></div>
      <div class="pj__p pj__verified" data-p="verified" aria-hidden="true"><i>✓</i>Verified purchase</div>
      <div class="pj__p pj__ltv" data-p="ltv" aria-hidden="true"><b>Lifetime value</b> $420 → $680</div>
      </div>
    </div>
  </div>
</div>

<script>
  // Locked journey: the section is five screens tall and its contents stay
  // pinned; how far you've scrolled through it picks the scene (1-5), so the
  // page guides you through every step before it lets go. The scene change
  // itself plays on its own timing (CSS), like Epsilon's.
  const root = document.querySelector('[data-pj]');
  if (root) {
    const stage = root.querySelector('[data-pj-stage]');
    const panels = [...root.querySelectorAll('[data-pj-panel]')];
    const dots = [...root.querySelectorAll('.pj__dots i')];
    let last = 1, queued = false;
    const set = () => {
      queued = false;
      const r = root.getBoundingClientRect();
      const p = Math.max(0, Math.min(0.9999, -r.top / Math.max(1, root.offsetHeight - innerHeight)));
      const n = Math.floor(p * 5) + 1;
      if (n === last) return;
      last = n;
      stage.dataset.scene = n;
      panels.forEach((el, i) => el.classList.toggle('is-on', i === n - 1));
      dots.forEach((el, i) => el.classList.toggle('is-on', i < n));
    };
    addEventListener('scroll', () => { if (!queued) { queued = true; requestAnimationFrame(set); } }, { passive: true });
    set();
  }
</script>
