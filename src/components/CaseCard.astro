---
import Ph from './Ph.astro';
import { formatDate } from '../data/caseStudies.js';
const { cs, isNew = false } = Astro.props;
---
<a class="case-card" href={`/case-studies/${cs.slug}`}>
  <div class="case-card__media">
    <Ph label={`${cs.client} photo`} style="position:absolute;inset:0" />
  </div>
  <div class="case-card__body">
    <p class="pf-eyebrow">{cs.client} · {formatDate(cs.date)}</p>
    <h3 class="t-h3">{cs.title}</h3>
  </div>
</a>
