---
// The site nav (Oct 25): one component for both layouts, so every page gets
// the same black frosted bar. Styles in src/styles/fnav.css.
import '../styles/fnav.css';
import { bySlug, SPINE, SERVICE_GROUPS } from '../data/capabilities.js';
// Capabilities dropdown (Epsilon-style menu): every capability page, grouped.
const MENU = [
  { title: 'Five steps forward', items: SPINE.map((s, i) => ({ slug: s.slug, name: bySlug(s.slug).name, tag: `0${i + 1} ${s.verb}` })) },
  ...SERVICE_GROUPS.map((g) => ({ title: g.title, items: g.slugs.map((slug) => ({ slug, name: bySlug(slug).name })) })),
];
---
<header class="fnav" data-fnav>
  <div class="fnav__bar">
    <a class="fnav__logo" href="/">Profectus</a>
    <nav aria-label="Main">
      <ul class="fnav__links">
        <li class="fnav__has-drop">
          <a href="/capabilities" aria-haspopup="true">Capabilities</a>
          <div class="fnav__drop">
            <div class="fnav__drop-inner">
              {MENU.map((col) => (
                <div class="fnav__col">
                  <p class="fnav__col-h">{col.title}</p>
                  <ul>{col.items.map((it) => <li><a href={`/capabilities/${it.slug}`}>{it.tag && <span>{it.tag}</span>}{it.name}</a></li>)}</ul>
                </div>
              ))}
              <a class="fnav__drop-all" href="/capabilities">All capabilities →</a>
            </div>
          </div>
        </li>
        <li><a href="/case-studies">Case Studies</a></li>
        <li><a href="/about">About</a></li>
      </ul>
    </nav>
    <a class="fnav__cta btn-gold glow" href="/contact">Get in Touch →</a>
    <button class="fnav__toggle" type="button" aria-controls="fnav-menu" aria-expanded="false" aria-label="Menu"><i></i><i></i></button>
  </div>
  <!-- Phones and narrow windows: the links move into a drop-down panel. -->
  <nav class="fnav__menu" id="fnav-menu" aria-label="Main (menu)">
    <a href="/capabilities">Capabilities</a>
    <div class="fnav__menu-caps">{MENU.flatMap((c) => c.items).map((it) => <a href={`/capabilities/${it.slug}`}>{it.name}</a>)}</div>
    <a href="/case-studies">Case Studies</a>
    <a href="/about">About</a>
    <a class="btn-gold" href="/contact">Get in Touch →</a>
  </nav>
</header>

<script>
  // Nav, measured on deloittedigital.com:
  // - Hide on any downward scroll once past the very top (y > 2); reveal on
  //   any upward scroll. No threshold, no delay. 200ms slide (CSS).
  // - Clear while the bar sits over the hero; white once it's past the
  //   hero's bottom edge (y >= heroHeight - navHeight), whichever way you go.
  // Gold glow: fades out across the first 175px of scroll (--glow).
  // One write per frame at most, only to the nav and the hero.
  const nav = document.querySelector('[data-fnav]');
  const hero = document.querySelector('[data-hero]');
  const turn = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--rw-nav-turn')) || 175;
  let queued = false, lastG = -1, lastY = scrollY, hidden = false, light = null;
  const apply = () => {
    queued = false;
    const y = scrollY, dy = y - lastY;
    lastY = y;
    if (dy > 0 && y > 2 && !hidden && !nav.classList.contains('is-open')) { hidden = true; nav.classList.add('is-hidden'); }
    else if (dy < 0 && hidden) { hidden = false; nav.classList.remove('is-hidden'); }
    const edge = hero ? hero.offsetHeight - nav.offsetHeight : 0;
    const isLight = y >= edge;
    if (isLight !== light) { light = isLight; nav.classList.toggle('is-light', isLight); }
    const g = 1 - Math.min(1, Math.max(0, y / turn));
    if (Math.abs(g - lastG) >= 0.004) {
      lastG = g;
      nav.style.setProperty('--glow', g.toFixed(3));
      if (hero) hero.style.setProperty('--glow', g.toFixed(3));
    }
  };
  addEventListener('scroll', () => { if (!queued) { queued = true; requestAnimationFrame(apply); } }, { passive: true });
  // Menu button (under 900px): opens the drop-down; Escape or a link closes it.
  const toggle = nav.querySelector('.fnav__toggle');
  const setMenu = (open) => { nav.classList.toggle('is-open', open); toggle.setAttribute('aria-expanded', String(open)); };
  toggle.addEventListener('click', () => setMenu(!nav.classList.contains('is-open')));
  nav.querySelectorAll('.fnav__menu a').forEach((a) => a.addEventListener('click', () => setMenu(false)));
  addEventListener('keydown', (e) => { if (e.key === 'Escape') setMenu(false); });
  // Keyboard users: focus inside a hidden nav brings it back.
  nav.addEventListener('focusin', () => { hidden = false; nav.classList.remove('is-hidden'); });
  apply();
</script>
